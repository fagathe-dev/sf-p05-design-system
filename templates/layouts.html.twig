<div class="layout-auth">
  <main class="auth-card">
    <header class="auth-header">
      <div class="auth-tabs">
        <a href="#" class="auth-tab active"><i class="ri-login-box-line"></i> Login</a>
        <a href="#" class="auth-tab"><i class="ri-user-add-line"></i> Sign Up</a>
      </div>
    </header>

    <div class="auth-body">
      <form>
        <!-- Tes form-groups ici -->
        <button class="btn btn-solid-tertiary w-100 btn-lg mt-4">Log In</button>
      </form>

      <div class="auth-divider"><span>Or</span></div>

      <div class="d-flex flex-column gap-3">
        <button class="btn btn-outline-tertiary w-100">
          <i class="ri-google-fill"></i> Continue with Google
        </button>
      </div>
    </div>

    <footer class="auth-footer">
      Don't have an account yet? <a href="#">Sign up</a>
    </footer>
  </main>
</div>

