<!-- Première ligne (Email) -->
<div class="form-floating-flushed mb-4">
  <input type="email" class="form-control" id="floatEmail" placeholder="name@example.com">
  <label for="floatEmail">Email address</label>
</div>

<!-- Ligne partagée (Grille + Flushed) -->
<div class="grid grid-cols-2 gap-4">
  <div class="form-floating-flushed mb-4">
    <input type="text" class="form-control" id="firstName" placeholder="First Name">
    <label for="firstName">First name</label>
  </div>
  <div class="form-floating-flushed mb-4">
    <input type="text" class="form-control" id="lastName" placeholder="Last Name">
    <label for="lastName">Last name</label>
  </div>
</div>

<div class="mb-4">
  <label class="form-label">Upload file</label>
  <input type="file" class="form-control">
</div>

<!-- Checkbox complexe avec description -->
<div class="form-check">
  <input class="form-check-input" type="checkbox" id="checkComment" checked>
  <label class="form-check-label" for="checkComment">
    Comments
    <span class="text-muted">Get notified when someones posts a comment on a posting.</span>
  </label>
</div>

<!-- Radio button -->
<div class="form-check">
  <input class="form-check-input" type="radio" name="options" id="radioEverything" checked>
  <label class="form-check-label" for="radioEverything">Everything</label>
</div>

<!-- Toggle Switch -->
<div class="form-check form-switch">
  <input class="form-check-input" type="checkbox" id="switchChecked" checked>
  <label class="form-check-label" for="switchChecked">Checked toggle</label>
</div>

<div class="mb-4">
  <label for="username" class="form-label">Username</label>
  <input type="text" id="username" class="form-control" placeholder="workcation.com/janesmith">
</div>

<!-- Input Valid (Success) -->
<div class="mb-4">
  <label class="form-label">Your name</label>
  <input type="text" class="form-control is-valid" value="Success input">
  <div class="valid-feedback">Well done! Some success message.</div>
</div>


<!-- Input Invalid (Error) -->
<div class="mb-4">
  <label class="form-label">Your name</label>
  <input type="text" class="form-control is-invalid" value="Error input">
  <div class="invalid-feedback">Oh, snapp! Some error message.</div>
</div>