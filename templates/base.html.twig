<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Base UI{% endblock %}</title>

  <link rel="shortcut icon" href="{{ asset(favicon_path) }}" type="image/x-icon">
  
  {# Librairie d'icônes #}
  <link rel="stylesheet" href="{{ asset('assets/ds-icons.css') }}">
  {# Design System compilé #}
  <link rel="stylesheet" href="{{ asset('css/ds-ui-kit.css') }}">
  {% block stylesheets %}{% endblock %}
</head>
<body>
  {% block body %}{% endblock %}

  <script type="module" src="{{ asset('js/main.js') }}"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>