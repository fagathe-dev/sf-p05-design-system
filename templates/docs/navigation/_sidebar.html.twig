        ['.sidebar-collapsed', 'Version réduite aux icônes'],
        ['.sidebar-header, .sidebar-brand', 'En-tête et marque'],
        ['.sidebar-content, .sidebar-body', 'Zone de liens qui défile'],
        ['.sidebar-section, .sidebar-section-title', 'Section et son titre (.sidebar-group-title : ancien nom)'],
        ['.sidebar-item', 'Conteneur d\'un lien parent et de son sous-menu'],
        ['.sidebar-link', 'Lien (.active) ou bouton parent d\'un sous-menu'],
        ['.sidebar-chevron', 'Chevron du parent (pivote quand aria-expanded="true")'],
        ['.sidebar-submenu', 'Sous-menu repliable (avec .collapse), un seul niveau'],
