{# Starter blog / app. Paramètres : host, hero (booléen) #}
{% set articles = [
  { category: 'Design', title: 'Construire un design system durable', image: 'photo-1498050108023-c5249f4df085', date: '12 mars' },
  { category: 'Front-end', title: 'Les tokens CSS en pratique', image: 'photo-1461749280684-dccba630e2f6', date: '8 mars' },
  { category: 'Accessibilité', title: 'Contrastes : la règle des 4.5:1', image: 'photo-1522071820081-009f0129c71c', date: '2 mars' },
] %}
{% include 'docs/getting-started/starters/_head.html.twig' with { host: host, title: 'Blog — Base UI' } only %}
<body>
  <div class="layout-app">
    <header class="app-header">
      <nav class="navbar navbar-expand-lg">
        <div class="container">
          <button class="navbar-toggler" type="button" data-ds-toggle="collapse" data-ds-target="#main-nav" aria-expanded="false" aria-controls="main-nav" aria-label="Ouvrir le menu">
            <i class="ri-menu-line"></i>
          </button>
          <a class="navbar-brand" href="#"><i class="ri-quill-pen-line text-primary"></i> Le Blog</a>
          <div class="collapse navbar-collapse" id="main-nav">
            <ul class="navbar-nav">
              <li><a class="nav-link" href="#">Accueil</a></li>
              <li><a class="nav-link active" href="#" aria-current="page">Articles</a></li>
              <li><a class="nav-link" href="#">Catégories</a></li>
              <li><a class="nav-link" href="#">À propos</a></li>
            </ul>
          </div>
          <div class="navbar-end">
            {% include 'docs/getting-started/starters/_account-menu.html.twig' with { prefix: 'blog' } only %}
          </div>
        </div>
      </nav>
    </header>

    <main class="app-main">
      <div class="container d-flex flex-column gap-12">
{% if hero %}
        <section class="hero">
          <div class="hero-content">
            <h1 class="hero-title">Idées, guides et retours d'expérience</h1>
            <p class="lead">Chaque semaine, un nouvel article sur le design et le développement front-end.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
              <a href="#articles" class="btn btn-primary btn-lg">Lire les articles</a>
              <a href="#" class="btn btn-ghost-primary btn-lg">S'abonner</a>
            </div>
          </div>
        </section>
{% else %}
        <header class="d-flex flex-column gap-2">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="#">Accueil</a></li>
              <li class="breadcrumb-item active" aria-current="page">Articles</li>
            </ol>
          </nav>
          <h1 class="mb-0">Articles</h1>
          <p class="lead text-muted mb-0">Guides et retours d'expérience sur le design et le front-end.</p>
        </header>
{% endif %}

        <section id="articles" class="d-flex flex-column gap-6">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h2 class="mb-0">Derniers articles</h2>
            <div class="segmented-control segmented-control-sm" role="radiogroup" aria-label="Catégorie">
              <button type="button" class="segmented-control-option" role="radio" aria-checked="true" data-value="all">Tous</button>
              <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="design">Design</button>
              <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="front">Front-end</button>
            </div>
          </div>
          <div class="row g-6">
{% for article in articles %}
            <div class="col-12 col-md-6 col-lg-4">
              <article class="card card-elevated h-100">
                <img src="https://images.unsplash.com/{{ article.image }}?w=600&q=80" class="card-img-top" alt="">
                <div class="card-body d-flex flex-column gap-2">
                  <span class="badge badge-primary align-self-start">{{ article.category }}</span>
                  <h3 class="card-title">{{ article.title }}</h3>
                  <p class="card-text text-muted">Publié le {{ article.date }} · 5 min de lecture</p>
                </div>
                <div class="card-footer">
                  <a href="#" class="btn btn-soft-primary btn-sm">Lire l'article</a>
                </div>
              </article>
            </div>
{% endfor %}
          </div>
          <nav aria-label="Pagination">
            <ul class="pagination">
              <li class="page-item disabled"><a class="page-link" aria-disabled="true" aria-label="Page précédente"><i class="ri-arrow-left-s-line"></i></a></li>
              <li class="page-item active"><a class="page-link" href="#" aria-current="page">1</a></li>
              <li class="page-item"><a class="page-link" href="#">2</a></li>
              <li class="page-item"><a class="page-link" href="#">3</a></li>
              <li class="page-item"><a class="page-link" href="#" aria-label="Page suivante"><i class="ri-arrow-right-s-line"></i></a></li>
            </ul>
          </nav>
        </section>
      </div>
    </main>

    <footer class="footer app-footer">
      <div class="container">
        <div class="footer-content">
          <a class="navbar-brand" href="#"><i class="ri-quill-pen-line text-primary"></i> Le Blog</a>
          <ul class="nav footer-links">
            <li><a class="nav-link" href="#">Articles</a></li>
            <li><a class="nav-link" href="#">Newsletter</a></li>
            <li><a class="nav-link" href="#">Contact</a></li>
          </ul>
        </div>
        <div class="footer-bottom">
          <span>© {{ 'now'|date('Y') }} Le Blog. Tous droits réservés.</span>
          <a href="#">Mentions légales</a>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
