{# Docs : Theme — sources : assets/ts/services/theme.ts, interactions/components/theme-switch.ts, foundation/_tokens.scss #}

<div class="component-demo">
  <p class="docs-lead">
    Service de mode d'affichage : <code>'auto'</code> (suit l'appareil), <code>'light'</code> ou
    <code>'dark'</code>. Le choix est mémorisé, appliqué sur <code>&lt;html data-ui-theme&gt;</code> et partagé
    entre les sélecteurs et les onglets ouverts.
  </p>

  <section class="docs-section" id="selecteur">
    <h3>Sélecteur de thème</h3>
    <p>
      Tout SegmentedControl qui porte <code>data-ds-theme-switch</code>, avec les options <code>auto</code>,
      <code>light</code> et <code>dark</code>, est relié au service. Essayez : toute la page change de thème, et le
      sélecteur du menu du compte se met à jour.
    </p>
{% set code %}
<div class="segmented-control" role="radiogroup" aria-label="Mode d'affichage" data-ds-theme-switch>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="true" data-value="auto" aria-label="Automatique" title="Automatique (suit le réglage de l'appareil)"><i class="ri-computer-line"></i></button>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="light" aria-label="Clair" title="Thème clair"><i class="ri-sun-line"></i></button>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="dark" aria-label="Sombre" title="Thème sombre"><i class="ri-moon-line"></i></button>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'stack' } only %}

    <h4>Avec libellés</h4>
{% set code %}
<div class="segmented-control segmented-control-full" role="radiogroup" aria-label="Mode d'affichage" data-ds-theme-switch>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="true" data-value="auto"><i class="ri-computer-line"></i> Automatique</button>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="light"><i class="ri-sun-line"></i> Clair</button>
  <button type="button" class="segmented-control-option" role="radio" aria-checked="false" data-value="dark"><i class="ri-moon-line"></i> Sombre</button>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code } only %}
  </section>

  <section class="docs-section" id="service">
    <h3>Service</h3>
    <p>
      <code>themeService</code> est une instance unique : tous les scripts de la page partagent le même état.
      Chaque changement émet aussi l'événement <code>ds:theme-change</code> sur <code>document</code>.
    </p>
{% set code %}
import { themeService } from '@/services/theme';

themeService.getMode();   // 'auto' | 'light' | 'dark' — la préférence
themeService.getTheme();  // 'light' | 'dark' — le thème affiché ('auto' résolu)
themeService.setMode('dark');

// Réagir aux changements (retourne la fonction de désabonnement)
const unsubscribe = themeService.subscribe(({ mode, theme }) => {
  console.log(`Préférence ${mode}, thème ${theme}`);
});

// Sans importer le service
document.addEventListener('ds:theme-change', (event) => {
  console.log(event.detail.theme);
});
{% endset %}
