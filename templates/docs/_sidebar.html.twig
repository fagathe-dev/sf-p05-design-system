{# Sommaire de la documentation : tiroir sous lg, colonne collante au-dessus #}
<aside class="sidebar sidebar-expand-lg docs-sidebar" id="docs-sidebar" aria-label="Sommaire de la documentation">
  <div class="sidebar-header">
    <div class="docs-search">
      <i class="ri-search-line" aria-hidden="true"></i>
      <input type="search" class="form-control form-control-sm" placeholder="Rechercher…" aria-label="Rechercher dans la documentation" aria-keyshortcuts="Control+K" data-docs-search>
      <kbd class="docs-search-hint" aria-hidden="true">Ctrl K</kbd>
    </div>
    <button type="button" class="btn-close d-lg-none" data-ds-dismiss="sidebar" data-ds-target="#docs-sidebar" aria-label="Fermer le sommaire"></button>
  </div>

  <nav class="sidebar-body" data-docs-nav>
    {% for item in docs_site.navigation %}
      <div class="sidebar-section" role="group" aria-labelledby="docs-nav-{{ item.type }}">
        <span class="sidebar-section-title" id="docs-nav-{{ item.type }}"><i class="{{ item.icon }}" aria-hidden="true"></i> {{ item.label }}</span>
        {% for link in item.pages %}
          {% set is_current = link.url == page.url %}
          <a href="{{ link.url }}" class="sidebar-link{{ is_current ? ' active' }}"{{ is_current ? ' aria-current="page"' }}>{{ link.title }}</a>
        {% endfor %}
      </div>
    {% endfor %}
    <p class="small text-muted mb-0 px-3" data-docs-search-empty hidden>Aucune page ne correspond à cette recherche.</p>
  </nav>
</aside>
