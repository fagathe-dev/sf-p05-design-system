{% extends 'layouts/app.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="py-4">
    {# Inclusion du fil d'Ariane intelligent #}
    {% include 'docs/_breadcrumb.html.twig' %}

    <header class="mb-5 text-center mt-3">
        <h1 class="display-5 fw-bold mb-3">UI Kit Documentation</h1>
        <p class="lead text-muted max-w-2xl mx-auto">
            Explorez notre système de composants Vanilla HTML/CSS organisé par types.
        </p>
    </header>

    {% if documentation is empty %}
        <div class="alert alert-soft-warning">
            <i class="ri-alert-line alert-icon"></i>
            <div class="alert-content">
                <strong>Aucun composant trouvé</strong><br>
                Commencez par créer des dossiers dans <code>templates/docs/</code>.
            </div>
        </div>
    {% else %}
        <div class="row g-4 justify-content-center">
            {% for type, components in documentation %}
                <div class="col-12 col-md-6 col-lg-4">
                    <a href="{{ path('component_docs_category', {type: type}) }}" class="text-decoration-none">
                        <div class="box box-secondary h-100 mb-0 form-selectable-label border-0">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar avatar-sm bg-secondary-subtle text-secondary-dark">
                                    <i class="ri-folder-2-line"></i>
                                </div>
                                <div>
                                    <h3 class="h5 mb-0 text-capitalize">{{ type }}</h3>
                                    <p class="text-muted small mb-0">{{ components|length }} composant(s) disponible(s)</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ asset('js/pages/demo-ui.js') }}"></script>
{% endblock %}