<div class="component-demo">
    <h3>✨ Bibliothèque d'icônes</h3>
    <div class="row row-cols-4 row-cols-md-6 g-3">
        {% for icon in icons %}
            <div class="col text-center">
                <i class="{{ icon }} fs-4 d-block mb-2"></i>
                <code class="small text-muted" style="font-size: 0.7rem">{{ icon|replace({'ri-': ''}) }}</code>
            </div>
        {% endfor %}
    </div>
</div>