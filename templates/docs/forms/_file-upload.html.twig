<div class="component-demo">
  <h3>📁 Upload de Fichiers</h3>
  <p class="text-muted mb-4">
    Un champ d'upload stylisé nativement via CSS, utilisant le pseudo-élément <code>::file-selector-button</code>.
  </p>

  <div class="row g-4 mb-5">
    <div class="col-12 col-lg-6">
      <div class="box box-secondary mb-0">
        <div class="mb-3">
          <label for="formFile" class="form-label">Sélectionner un document</label>
          <input class="form-control" type="file" id="formFile">
        </div>
        
        <div class="mb-0">
          <label for="formFileDisabled" class="form-label">Upload désactivé</label>
          <input class="form-control" type="file" id="formFileDisabled" disabled>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <h5>Code d'exemple</h5>
    {% set codeExample %}
<div class="mb-3">
  <label for="formFile" class="form-label">Upload image</label>
  <input class="form-control" type="file" id="formFile" accept="image/*">
</div>
    {% endset %}
    {% include 'fragments/components/_code-block.html.twig' with {
      'code': codeExample,
      'language': 'html',
      'title': 'Structure HTML File Upload'
    } %}
  </div>
</div>