{# Docs : Images & Figures — sources : assets/scss/content/_image.scss, _figure.scss #}
{% set photo = 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80' %}

<div class="component-demo">
  <p class="docs-lead">
    Images responsives, vignettes et figures légendées. Les images gardent leur ratio et ne
    dépassent jamais leur conteneur.
  </p>

  <section class="docs-section" id="fluide">
    <h3>Image fluide</h3>
    <p><code>.img-fluid</code> limite l'image à la largeur de son parent et garde son ratio.</p>
{% set code %}
<img src="{{ photo }}" class="img-fluid" alt="Poste de travail">
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code } only %}
  </section>

  <section class="docs-section" id="vignette">
    <h3>Vignette</h3>
    <p><code>.img-thumbnail</code> encadre l'image d'une surface arrondie, sans ombre.</p>
{% set code %}
<img src="{{ photo }}" class="img-thumbnail" alt="Poste de travail" style="max-inline-size: 16rem;">
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code } only %}
  </section>

  <section class="docs-section" id="arrondis">
    <h3>Arrondis</h3>
    <p>Les utilitaires <code>.rounded-*</code> s'appliquent aux images.</p>
{% set code %}
<img src="https://i.pravatar.cc/120?img=15" class="rounded-sm" alt="Arrondi sm" width="96" height="96">
<img src="https://i.pravatar.cc/120?img=15" class="rounded-lg" alt="Arrondi lg" width="96" height="96">
<img src="https://i.pravatar.cc/120?img=15" class="rounded-circle" alt="Cercle" width="96" height="96">
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'stack' } only %}
  </section>

  <section class="docs-section" id="figure">
    <h3>Figure</h3>
    <p><code>.figure</code> empile l'image et sa légende ; la légende est en texte secondaire.</p>
{% set code %}
<figure class="figure" style="max-inline-size: 20rem;">
  <img src="{{ photo }}" class="figure-img img-fluid rounded" alt="Poste de travail">
  <figcaption class="figure-caption">Un poste de travail en télétravail.</figcaption>
</figure>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code } only %}

    <h4>Alignement de la légende</h4>
{% set code %}
<figure class="figure" style="max-inline-size: 20rem;">
  <img src="{{ photo }}" class="figure-img img-fluid rounded" alt="Poste de travail">
  <figcaption class="figure-caption text-end"><i class="ri-camera-lens-line"></i> Crédit : Unsplash</figcaption>
</figure>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code } only %}
  </section>

  <section class="docs-section" id="classes">
    <h3>Classes</h3>
    {% include 'docs/_reference.html.twig' with {
      rows: [
        ['.img-fluid', 'Image responsive'],
        ['.img-thumbnail', 'Vignette encadrée'],
        ['.figure', 'Image + légende empilées'],
        ['.figure-img', 'Image de la figure'],
        ['.figure-caption', 'Légende'],
      ],
    } only %}
  </section>
</div>
