<div class="component-demo">
  <h3>📸 Images & Figures</h3>
  <p class="text-muted mb-4">
    Styles responsives pour les images (Thumbnails) et balises sémantiques <code>&lt;figure&gt;</code> pour intégrer des légendes propres.
  </p>

  <div class="row g-4 mb-5">
    <div class="col-12 col-md-6">
      <div class="box box-secondary h-100 mb-0">
        <h5 class="mb-4">Image Thumbnail</h5>
        <p class="small text-muted mb-3">La classe <code>.img-thumbnail</code> ajoute un padding, un fond de carte et une ombre douce.</p>
        
        <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&q=80" class="img-thumbnail" alt="Espace de travail">
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="box box-secondary h-100 mb-0">
        <h5 class="mb-4">Composant Figure</h5>
        <p class="small text-muted mb-3">Associe une image et sa légende avec une typographie adaptée.</p>
        
        <figure class="figure mb-0">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600&q=80" class="figure-img img-fluid rounded" alt="Équipe">
          <figcaption class="figure-caption text-end mt-2">
            <i class="ri-camera-lens-line"></i> Crédit : Unsplash Photography
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <h5>Code d'exemple</h5>
    {% set codeExample %}
<img src="photo.jpg" class="img-thumbnail img-fluid" alt="...">

<figure class="figure">
  <img src="photo.jpg" class="figure-img img-fluid rounded" alt="...">
  <figcaption class="figure-caption">Légende de l'image</figcaption>
</figure>
    {% endset %}
    {% include 'fragments/components/_code-block.html.twig' with {
      'code': codeExample,
      'language': 'html',
      'title': 'Structure HTML Images'
    } %}
  </div>
</div>