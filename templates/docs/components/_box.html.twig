{% set boxes = ['primary', 'secondary', 'tertiary', 'info', 'success', 'warning', 'danger'] %}

<div class="component-demo">
  <h3>📦 Box</h3>
  {% for box in boxes %}
  <div class="box box-{{ box }}">
    <h4 class="box-title">{{ box|capitalize }}</h4>
    <p>Une box avec une teinte subtile pour mettre en avant du contenu.</p>
  </div>
  {% endfor %}
</div>