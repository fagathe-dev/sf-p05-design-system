{% set colors = ['primary', 'secondary', 'tertiary', 'success', 'warning', 'info', 'danger'] %}

<div class="component-demo">
  <h3>🏷️ Badges solid</h3>
  <div class="d-flex gap-2">
    {% for color in colors %}
      <span class="badge badge-solid-{{ color }}">{{ color|capitalize }}</span>
    {% endfor %}
  </div>

  <h3>🏷️ Badges normaux</h3>
  <div class="d-flex gap-2">
    {% for color in colors %}
      <span class="badge badge-{{ color }}">{{ color|capitalize }}</span>
    {% endfor %}
  </div>
</div>