  <section class="docs-section" id="alignement">
    <h3>Alignement à droite</h3>
    <p><code>.dropdown-menu-end</code> aligne le menu sur le bord droit du déclencheur.</p>
{% set code %}
<div class="d-flex justify-content-end">
  <div class="dropdown">
    <button type="button" class="btn btn-secondary dropdown-toggle" data-ds-toggle="dropdown" aria-expanded="false">
      Aligné à droite
    </button>
    <div class="dropdown-menu dropdown-menu-end">
      <a class="dropdown-item" href="#">Action</a>
      <a class="dropdown-item" href="#">Autre action</a>
    </div>
  </div>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'tall' } only %}
  </section>

  <section class="docs-section" id="liste">
    <h3>Menu en liste</h3>
    <p>Le menu peut être une liste <code>&lt;ul&gt;</code> : ses puces sont retirées.</p>
{% set code %}
<div class="dropdown">
  <button type="button" class="btn btn-secondary dropdown-toggle" data-ds-toggle="dropdown" aria-expanded="false">
    Langue
  </button>
  <ul class="dropdown-menu">
    <li><a class="dropdown-item active" href="#">Français</a></li>
    <li><a class="dropdown-item" href="#">English</a></li>
    <li><a class="dropdown-item" href="#">Español</a></li>
  </ul>
</div>
{% endset %}
