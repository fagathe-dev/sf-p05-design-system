{% set code %}
<div class="dropdown">
  <button type="button" class="btn btn-secondary dropdown-toggle" data-ds-toggle="dropdown" aria-expanded="false">
    Trier par
  </button>
  <div class="dropdown-menu">
    <a class="dropdown-item active" href="#" aria-current="true">Date</a>
