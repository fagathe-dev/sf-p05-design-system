{% extends 'docs/base.html.twig' %}

{% block docs_body %}
<div class="dashboard-overlay docs-overlay" data-ds-dismiss="sidebar" data-ds-target="#docs-sidebar"></div>

<div class="docs-container docs-layout">
  {% include 'docs/_sidebar.html.twig' %}

  <main class="docs-main">
    <header class="docs-page-header">
      <p class="docs-page-category">{{ category.label }}</p>
      <h1 class="docs-page-title">{{ page.title }}</h1>
      <a class="docs-page-source" href="https://github.com/fagathe-dev/sf-p05-design-system/blob/master/templates/{{ component_template }}">
        <i class="ri-github-fill" aria-hidden="true"></i> Voir la source de cette page
      </a>
    </header>

    {# Sommaire de la page, construit par assets/ts/pages/docs.ts à partir des titres #}
    <aside class="docs-toc" data-docs-toc hidden>
      <button type="button" class="btn btn-outline-secondary btn-sm docs-toc-toggle" data-ds-toggle="collapse" data-ds-target="#docs-toc-links" aria-expanded="false" aria-controls="docs-toc-links">
        Sur cette page <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
      </button>
      <p class="docs-toc-title" id="docs-toc-title">Sur cette page</p>
      <nav class="collapse" id="docs-toc-links" aria-labelledby="docs-toc-title">
        <ul class="docs-toc-list" data-docs-toc-list></ul>
      </nav>
    </aside>

    <div class="docs-content" data-docs-content>
      {% include component_template %}
    </div>

    <nav class="docs-pager" aria-label="Pages voisines">
      {% if previous %}
        <a class="docs-pager-link" href="{{ previous.page.url }}" rel="prev">
          <span class="docs-pager-label"><i class="ri-arrow-left-line" aria-hidden="true"></i> Précédent</span>
          <span class="docs-pager-title">{{ previous.page.title }}</span>
          <span class="docs-pager-category">{{ previous.category.label }}</span>
        </a>
      {% endif %}
      {% if next %}
        <a class="docs-pager-link docs-pager-next" href="{{ next.page.url }}" rel="next">
          <span class="docs-pager-label">Suivant <i class="ri-arrow-right-line" aria-hidden="true"></i></span>
          <span class="docs-pager-title">{{ next.page.title }}</span>
          <span class="docs-pager-category">{{ next.category.label }}</span>
        </a>
      {% endif %}
    </nav>
  </main>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script type="module" src="{{ asset('js/pages/demo-ui.js') }}"></script>
{% endblock %}
