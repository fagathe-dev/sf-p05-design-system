{# Docs : Container — source : assets/scss/layout/_container.scss #}
{% set widths = [
  ['Moins de 576px', '100%', '100%', '100%', '100%', '100%', '100%'],
  ['sm ≥ 576px', '540px', '540px', '100%', '100%', '100%', '100%'],
  ['md ≥ 768px', '720px', '720px', '720px', '100%', '100%', '100%'],
  ['lg ≥ 992px', '960px', '960px', '960px', '960px', '100%', '100%'],
  ['xl ≥ 1200px', '1140px', '1140px', '1140px', '1140px', '1140px', '100%'],
  ['xxl ≥ 1400px', '1320px', '1320px', '1320px', '1320px', '1320px', '1320px'],
] %}

<div class="component-demo">
  <p class="docs-lead">
    Les conteneurs centrent le contenu et lui donnent une gouttière latérale de 16px. Leur largeur
    maximale suit les breakpoints.
  </p>

  <section class="docs-section" id="standard">
    <h3>Conteneur standard</h3>
    <p><code>.container</code> prend une largeur maximale fixe à chaque breakpoint.</p>
{% set code %}
<div class="container">
  <div class="docs-box">.container</div>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'surface' } only %}
  </section>

  <section class="docs-section" id="fluide">
    <h3>Conteneur fluide</h3>
    <p><code>.container-fluid</code> occupe toujours toute la largeur disponible.</p>
{% set code %}
<div class="container-fluid">
  <div class="docs-box">.container-fluid</div>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'surface' } only %}
  </section>

  <section class="docs-section" id="responsive">
    <h3>Conteneurs responsives</h3>
    <p>
      <code>.container-{bp}</code> reste fluide jusqu'au breakpoint indiqué, puis suit les largeurs de
      <code>.container</code>.
    </p>
{% set code %}
<div class="container-sm"><div class="docs-box">.container-sm</div></div>
<div class="container-md"><div class="docs-box">.container-md</div></div>
<div class="container-lg"><div class="docs-box">.container-lg</div></div>
<div class="container-xl"><div class="docs-box">.container-xl</div></div>
<div class="container-xxl"><div class="docs-box">.container-xxl</div></div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'column surface' } only %}
  </section>

  <section class="docs-section" id="largeurs">
    <h3>Largeurs maximales</h3>
    <div class="table-responsive docs-reference">
      <table class="table align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">Écran</th>
            <th scope="col"><code>.container</code></th>
            <th scope="col"><code>-sm</code></th>
            <th scope="col"><code>-md</code></th>
            <th scope="col"><code>-lg</code></th>
            <th scope="col"><code>-xl</code></th>
            <th scope="col"><code>-xxl</code></th>
          </tr>
        </thead>
        <tbody>
          {% for row in widths %}
            <tr>
              {% for cell in row %}
                <td>{{ cell }}</td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="docs-section" id="personnalisation">
    <h3>Personnalisation</h3>
{% set code %}
<div class="container" style="--container-gutter: var(--ds-space-8);">
  <div class="docs-box">Gouttière de 32px</div>
</div>
{% endset %}
    {% include 'docs/_example.html.twig' with { code: code, layout: 'surface' } only %}
    {% include 'docs/_reference.html.twig' with {
      headers: ['Token', 'Défaut', 'Rôle'],
      rows: [
        ['--container-gutter', '<code>--ds-space-4</code>', 'Padding latéral'],
        ['--ds-container-{bp}', '<code>33.75rem</code> … <code>82.5rem</code>', 'Largeurs maximales (System Tokens)'],
      ],
    } only %}
  </section>

  <section class="docs-section" id="classes">
    <h3>Classes</h3>
    {% include 'docs/_reference.html.twig' with {
      rows: [
        ['.container', 'Largeur maximale à chaque breakpoint'],
        ['.container-fluid', 'Toujours pleine largeur'],
        ['.container-{sm|md|lg|xl|xxl}', 'Fluide jusqu\'au breakpoint'],
      ],
    } only %}
  </section>
</div>
