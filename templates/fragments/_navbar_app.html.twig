<header class="app-header">
  <nav class="navbar navbar-expand-lg">
    <div class="container gap-3">
      
      <!-- Brand -->
      <a class="navbar-brand" href="{{ path('app_home_index') }}">
        <i class="ri-box-3-fill text-primary"></i> Base
      </a>
      
      {% if app.environment == 'dev' %}
        <!-- Toggler (Mobile) -->
        <button class="navbar-toggler" type="button" data-ds-toggle="collapse" data-ds-target="#appNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <i class="ri-menu-line"></i>
        </button>

        <!-- Zone Collapsible -->
        <div class="collapse navbar-collapse" id="appNavbarCollapse">
          
            <!-- Liens -->
          <ul class="navbar-nav">
            <li><a href="#" class="nav-link active">Accueil</a></li>
            <li><a href="#" class="nav-link">Articles</a></li>
            <li><a href="#" class="nav-link">Tarifs</a></li>
          </ul>

          <!-- Actions (Droite sur desktop, Bas sur mobile) -->
          <div class="navbar-actions">
            {% if app.user %}
              {{ include('fragments/_navbar_auth_toggler.html.twig') }}
            {% else %}
              <a href="{{ path('app_home_index') }}" class="btn btn-ghost-secondary w-100">Connexion</a>
              <a href="{{ path('app_home_index') }}" class="btn btn-solid-primary w-100">S'inscrire</a>
            {% endif %}
          </div>
            

        </div>
      {% endif %}

    </div>
  </nav>
</header>