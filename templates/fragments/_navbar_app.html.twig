<header class="app-header">
  <nav class="navbar navbar-expand-lg">
    <div class="container">

      {% if app.environment == 'dev' %}
        <!-- Toggler (mobile, à gauche) -->
        <button class="navbar-toggler" type="button" data-ds-toggle="collapse" data-ds-target="#appNavbarCollapse" aria-expanded="false" aria-controls="appNavbarCollapse" aria-label="Ouvrir le menu">
          <i class="ri-menu-line"></i>
        </button>
      {% endif %}

      <!-- Brand -->
      <a class="navbar-brand" href="{{ path('app_home_index') }}">
        <i class="ri-box-3-fill text-primary"></i> Base
      </a>

      {% if app.environment == 'dev' %}
        <!-- Liens : panneau repliable sous la barre sur mobile, en ligne sur desktop -->
        <div class="collapse navbar-collapse" id="appNavbarCollapse">
          <ul class="navbar-nav">
            <li><a href="#" class="nav-link active" aria-current="page">Accueil</a></li>
            <li><a href="#" class="nav-link">Articles</a></li>
            <li><a href="#" class="nav-link">Tarifs</a></li>
          </ul>

          {% if not app.user %}
            <div class="navbar-actions">
              <a href="{{ path('app_home_index') }}" class="btn btn-ghost-secondary w-100">Connexion</a>
              <a href="{{ path('app_home_index') }}" class="btn btn-solid-primary w-100">S'inscrire</a>
            </div>
          {% endif %}
        </div>

        {% if app.user %}
          <!-- Menu du compte : toujours visible, à droite -->
          <div class="navbar-end">
            {{ include('fragments/_navbar_auth_dropdown.html.twig') }}
          </div>
        {% endif %}
      {% endif %}

    </div>
  </nav>
</header>
